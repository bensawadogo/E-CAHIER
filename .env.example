# Ecahier - Configuration Environment
# Copiez ce fichier en .env et adaptez les valeurs.

# Application
CAHIER_DEBUG=false

# API
CAHIER_API_HOST=0.0.0.0
CAHIER_API_PORT=8000

# Base de données locale (SQLite) — offline-first
CAHIER_SQLITE_PATH=data/cahier_boutique.db

# Base de données serveur (PostgreSQL) — sync optionnelle
# Laissez vide pour fonctionner 100% offline
DATABASE_URL=

# Sécurité — chiffrement PII
# Générer une clé avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAHIER_PII_ENCRYPTION_KEY=

# Sécurité — authentification
CAHIER_AUTH_SECRET=

# Stockage
CAHIER_PHOTOS_DIR=data/photos
CAHIER_STORAGE_DIR=data/storage

# Synchronisation
CAHIER_SYNC_QUEUE_PATH=data/sync_queue.json
CAHIER_SERVER_URL=
CAHIER_SYNC_MAX_RETRIES=3
CAHIER_SYNC_BASE_DELAY=1.0

# OCR (Tesseract)
TESSERACT_PATH=tesseract